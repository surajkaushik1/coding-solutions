#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    string s1, s2;
	    cin>>s1>>s2;
	    int cnt1 = 0 , cnt2 =0;
	    for(int i=0;i<n;i++){
	        if(s1[i]=='1'){
	            cnt1++;
	        }
	        if(s2[i]=='1'){
	            cnt2++;
	        }
	    }
	    if(cnt1==cnt2){
	        cout<<"YES"<<endl;
	    }
	    else{
	        cout<<"NO"<<endl;
	    }
	}
}
